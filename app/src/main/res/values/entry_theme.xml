<resources>
    <style name="ThemeOverlay.MyFinances.Entry.Red" parent="ThemeOverlay.MyFinances.AlertDialog">
        <item name="alertDialogTheme">@style/ThemeOverlay.MyFinances.Entry.Red</item>
        <item name="android:colorBackgroundFloating">@color/red_50</item>
        <item name="android:textColorPrimary">@color/red_950</item>
        <item name="android:textColorSecondary">@color/red_800</item>
        <item name="android:textColorHint">@color/red_800</item>
        <item name="financeTextColor">@color/red_950</item>
        <item name="financeActionColor">@color/red_700</item>
