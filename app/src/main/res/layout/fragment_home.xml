<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <ScrollView
        android:id="@+id/fragment_home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/neutral_100"
        android:padding="15dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/fragment_home_constraint_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fragment_home_constraint_l_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/circlemyfinances"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/fragment_home_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MyFinances"
                    android:textColor="@color/neutral_950"
                    android:textSize="26sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/fragment_home_month_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/fragment_home_constraint_l_icon" />

            <LinearLayout
                android:id="@+id/fragment_home_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/fragment_home_month_selector">
                <Button android:id="@+id/fragment_home_add_income"
                    android:textColor="@color/neutral_50"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginRight="12dp"
                    android:backgroundTint="@color/emerald_700"
                    android:layout_height="wrap_content" android:text="+ Receita"/>
                <Button android:id="@+id/fragment_home_add_expense"
                    android:textColor="@color/neutral_50"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:backgroundTint="@color/red_700"
                    android:layout_height="wrap_content" android:text="+ Despesa"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fragment_home_card_saldos"
                style="@style/Widget.MyFinances.HomeBox"
                android:layout_width="match_parent"
                android:layout_height="255dp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@+id/fragment_home_actions">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/fragment_home_saldo_conta_alias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo acumulado previsto"
                        android:textSize="14sp"
                        android:textColor="@color/neutral_800"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.162" />

                    <com.douglasfj.myfinances.ui.shared.SensitiveTextView
                        android:id="@+id/fragment_home_saldo_conta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_default_money"
                        android:textColor="@color/neutral_950"
                        android:textSize="20sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/fragment_home_saldo_conta_alias" />


                    <com.douglasfj.myfinances.ui.shared.SetSentiveImageButtonView
                        android:id="@+id/fragment_home_sensitive_visibility_button"
                        android:layout_width="36dp"
                        android:layout_height="23dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/transparent"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/fragment_home_saldo_conta"
                        app:tint="@color/neutral_800" />

                    <TextView
                        android:id="@+id/fragment_home_saldo_entrada_alias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Receitas do mês"
                        android:textColor="@color/emerald_600"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.16"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.593" />

                    <com.douglasfj.myfinances.ui.shared.SensitiveTextView
                        android:id="@+id/fragment_home_saldo_entrada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/str_default_money"
                        android:textColor="@color/emerald_950"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="@+id/fragment_home_saldo_entrada_alias"
                        app:layout_constraintStart_toStartOf="@+id/fragment_home_saldo_entrada_alias"
                        app:layout_constraintTop_toBottomOf="@+id/fragment_home_saldo_entrada_alias" />

                    <TextView
                        android:id="@+id/fragment_home_saldo_saida_alias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saída"
                        android:textColor="@color/red_600"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.84"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.593" />

                    <com.douglasfj.myfinances.ui.shared.SensitiveTextView
                        android:id="@+id/fragment_home_saldo_saida"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/str_default_money"
                        android:textColor="@color/red_950"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="@+id/fragment_home_saldo_saida_alias"
                        app:layout_constraintStart_toStartOf="@+id/fragment_home_saldo_saida_alias"
                        app:layout_constraintTop_toBottomOf="@+id/fragment_home_saldo_saida_alias" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:background="@color/neutral_200"
                        app:layout_constraintTop_toBottomOf="@id/fragment_home_saldo_saida"/>

                    <TextView
                        android:id="@+id/fragment_home_saldo_anterior_alias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Mês anterior"
                        android:textColor="@color/neutral_700"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/fragment_home_saldo_entrada"
                        app:layout_constraintEnd_toEndOf="@+id/fragment_home_saldo_entrada"
                        app:layout_constraintTop_toBottomOf="@+id/fragment_home_saldo_entrada" />

                    <com.douglasfj.myfinances.ui.shared.SensitiveTextView
                        android:id="@+id/fragment_home_saldo_anterior"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="R$ 000,00"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_600"
                        app:layout_constraintStart_toStartOf="@+id/fragment_home_saldo_anterior_alias"
                        app:layout_constraintEnd_toEndOf="@id/fragment_home_saldo_anterior_alias"
                        app:layout_constraintTop_toBottomOf="@id/fragment_home_saldo_anterior_alias"/>

                    <TextView
                        android:id="@+id/fragment_home_resultado_mes_alias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Resultado mês"
                        android:textColor="@color/neutral_700"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/fragment_home_saldo_saida"
                        app:layout_constraintEnd_toEndOf="@+id/fragment_home_saldo_saida"
                        app:layout_constraintTop_toBottomOf="@+id/fragment_home_saldo_saida" />

                    <com.douglasfj.myfinances.ui.shared.SensitiveTextView
                        android:id="@+id/fragment_home_resultado_mes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="R$ 000,00"
                        android:textSize="12sp"
                        android:textColor="@color/neutral_600"
                        app:layout_constraintStart_toStartOf="@id/fragment_home_resultado_mes_alias"
                        app:layout_constraintEnd_toEndOf="@id/fragment_home_resultado_mes_alias"
                        app:layout_constraintTop_toBottomOf="@id/fragment_home_resultado_mes_alias"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fragment_home_card_falta_pagar"
                style="@style/Widget.MyFinances.HomeBox"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@+id/fragment_home_card_saldos">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="15dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/fragment_home_title_falta_pagar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_card_falta_pagar"
                            android:textColor="@color/neutral_800"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.douglasfj.myfinances.ui.shared.ScrollAwareGridView
                        android:id="@+id/fragment_home_lista_falta_pagar"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:numColumns="2"
                        android:verticalSpacing="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/fragment_home_title_falta_pagar"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:listitem="@layout/layout_despesa" />
                    <TextView android:id="@+id/fragment_home_pending_empty"
                        android:textColor="@color/neutral_800"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Nenhuma despesa pendente neste mês."
                        android:paddingTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/fragment_home_title_falta_pagar"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="30dp"
                style="@style/Widget.MyFinances.HomeBox"
                app:layout_constraintTop_toBottomOf="@id/fragment_home_card_falta_pagar">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="15dp">

                    <TextView
                        android:id="@+id/textView"
                        android:textColor="@color/neutral_800"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/str_card_ultimas_despesas"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.douglasfj.myfinances.ui.shared.ScrollAwareListView
                        android:id="@+id/fragment_home_lista_ultimas_despesas"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView"
                        app:layout_constraintBottom_toBottomOf="parent"
                        tools:listitem="@layout/layout_ultimas_despesas"/>
                    <TextView android:id="@+id/fragment_home_recent_empty"
                        android:textColor="@color/neutral_800"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Adicione uma despesa para começar."
                        android:paddingTop="20dp"
                        app:layout_constraintTop_toBottomOf="@id/textView"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
